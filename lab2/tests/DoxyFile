# Project details
PROJECT_NAME           = "Service Center Management System"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Object-Oriented Service Center and Maintenance Tracking Application"
OUTPUT_DIRECTORY       = docs
OUTPUT_LANGUAGE        = English

# Source parsing settings
INPUT                  = include src
FILE_PATTERNS          = *.hpp *.h *.cpp
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* */tests/*

# Extraction options (include private members for lab evaluation)
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES

# Code browsing and cross-referencing
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# HTML output configuration
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80
SEARCHENGINE           = YES

# Other formats
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

# Diagrams & Graphs (requires Graphviz installed)
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CLASS_DIAGRAMS         = YES
COLLABORATION_GRAPH    = YES
CLASS_GRAPH            = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES